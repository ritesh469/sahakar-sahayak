# === LLM & Embeddings ===
OPENAI_API_KEY=sk-your-openai-api-key
GROQ_API_KEY=gsk_your-groq-api-key
# Chat LLM provider: groq (OpenAI-compatible API) or openai
LLM_PROVIDER=groq
LLM_MODEL_ANSWER=openai/gpt-oss-120b
# Grader (CRAG / Self-RAG / Ragas) on another model: Groq rate limits are per model
LLM_MODEL_GRADER=qwen/qwen3.8-27b
LLM_REASONING_EFFORT=low
LLM_MAX_RETRIES=6
# OpenAI instead of Groq (no 200k tokens/day free-tier limit). The grader is also the Ragas
# judge, so keep it a non-reasoning model (Ragas sets a temperature, gpt-5* rejects it):
#   LLM_PROVIDER=openai
#   LLM_MODEL_ANSWER=gpt-5.4-mini
#   LLM_MODEL_GRADER=gpt-4.1-mini
# Text2SQL (K8s leftover): false = no LLM router, every query is RAG
SQL_ENABLED=false

# Embeddings: "local" (sentence-transformers, GPU if available) or "openai".
# EMBEDDING_DIM must match the model (bge-m3 = 1024, text-embedding-3-small = 1536).
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# === Chunking ===
# Tokens are counted with the embedding model's tokenizer.
CHUNK_SIZE=512
CHUNK_OVERLAP=0
# PDF text backend: pypdfium2 or docling_parse
PDF_BACKEND=pypdfium2
# Converted-document cache (re-chunking skips docling conversion); empty = off
DOC_CACHE_DIR=data/cache/docling

# === Host ports (docker compose + local URLs) ===
# Change these if another project already uses 5432 / 6333 / 8000.
POSTGRES_HOST_PORT=5432
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
API_HOST_PORT=8000

# === Vector DB ===
QDRANT_URL=http://localhost:6333
# Collection name = <prefix>_<chunk_size>, e.g. coop_512
QDRANT_COLLECTION_PREFIX=coop

# === Postgres ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adv_rag

# === Cache (Upstash) ===
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-redis-token
CACHE_TTL_EMBEDDINGS=604800        # 7 days
CACHE_TTL_RAG=3600                 # 1 hour
CACHE_TTL_SQL_GEN=86400            # 24 hours
CACHE_TTL_SQL_RESULT=900           # 15 min
CACHE_TTL_INTENT=86400             # 24 hours

# === Doc dedup ===
STORAGE_BACKEND=local              # or "s3"
S3_CACHE_BUCKET=adv-rag-cache
AWS_REGION=us-east-1

# === Web search ===
TAVILY_API_KEY=your-tavily-api-key

# === Auth ===
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MINUTES=60

# === Rate limit + budget ===
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_TOKENS_PER_USER_DAILY=100000
AUTH_LOGIN_RATE_LIMIT_PER_MIN=5
AUTH_REGISTER_RATE_LIMIT_PER_HOUR=3

# === Input restructuring ===
MAX_INPUT_TOKENS=3000
RESERVED_CONTEXT_TOKENS=1000
RESERVED_OUTPUT_TOKENS=1000

# === Security thresholds ===
PROMPT_INJECTION_THRESHOLD=0.75
PROMPT_INJECTION_SCAN_DEVANAGARI=false   # true = llm-guard's English injection model also scans Hindi/Marathi (blocks normal questions)
TOXICITY_THRESHOLD=0.75
OUTPUT_TOXICITY_THRESHOLD=0.5
MAX_VALIDATION_RETRIES=2

# === Retrieval defaults ===
HYDE_NUM_HYPOTHESES=3
HYDE_ENABLED_BY_DEFAULT=false
HYBRID_SEARCH_ENABLED=true
RRF_K=60
SEARCH_MODE=hybrid                 # dense | bm25 | tfidf | hybrid (dense + BM25, RRF)
RERANKER_BACKEND=local             # or "voyage"
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
VOYAGE_API_KEY=
VOYAGE_MODEL=rerank-2.5
RERANKER_INITIAL_TOP_K=20
RERANKING_ENABLED_BY_DEFAULT=true
CRAG_RELEVANCE_THRESHOLD=0.7
CRAG_AMBIGUOUS_THRESHOLD=0.5
CRAG_ENABLED_BY_DEFAULT=false
# CRAG web fallback (Tavily): false = answers only from our documents
WEB_FALLBACK_ENABLED=false
PII_REDACT_PERSON_NAMES=false      # true = llm-guard also redacts PERSON names (English NER; breaks Hindi/Marathi)
REFLECTION_MIN_SCORE=0.85
MAX_REFLECTION_RETRIES=2
SELF_REFLECTIVE_ENABLED_BY_DEFAULT=false
# Self-RAG reviewer prompt: refusal_aware (a correct refusal is a good answer) | original
SELF_RAG_PROMPT=refusal_aware

# === Vanna ===
VANNA_MODEL=gpt-4o
VANNA_TEMPERATURE=0.0
VANNA_SEED=42

# === Logging ===
LOG_JSON=false                     # true in prod
LOG_LEVEL=INFO
